{
  "name": "Single Domain Test - Enhanced Intent Capture",
  "icp_text": "Test enhanced intent capture on single dental practice broker domain",
  "queries": [
    "usdentalpractices.com"
  ],
  "required_fields": ["domain"],
  "optional_fields": ["company_name", "industry"],
  "threshold": 0.1,
  "filtering_strict": false,
  "mode": "fast",
  "refresh_policy": {
    "domain_ttl_days": 1,
    "crawl_ttl_days": 1,
    "enrich_ttl_days": 1,
    "max_pages": 1,
    "default_country": "US"
  },
  "concurrency": {
    "max_concurrent_requests": 1
  },
  "search": {
    "max_results_per_query": 1
  },
  "testing": {
    "process_rejected": true,
    "process_low_crawl": true
  },
  "caps": {
    "max_domains_per_run": 1,
    "max_crawl_per_run": 1,
    "max_enrich_per_run": 1
  },
  "intent_config": {
    "purpose": "dental_practice_acquisition",
    "target_action": "sell_practice",
    "intent_signals": {
      "high_intent": [
        "owner retirement planning",
        "succession planning",
        "looking for partners",
        "transition mode",
        "no clear family successor",
        "owner age 60+",
        "practice for sale",
        "broker listing",
        "exit planning",
        "transition assistance",
        "FOR SALE",
        "dental practice for sale",
        "practice transition",
        "owner exit",
        "broker listing",
        "practice listing"
      ],
      "medium_intent": [
        "expansion planning",
        "growth capital needed",
        "partnership exploring",
        "early succession planning",
        "considering strategic options",
        "strategic buyer",
        "growth opportunity"
      ],
      "low_intent": [
        "recently acquired",
        "part of corporate group",
        "family succession secure",
        "no exit plans",
        "committed to independence",
        "recently expanded",
        "not for sale"
      ]
    },
    "intent_sources": [
      "about_pages",
      "leadership_pages",
      "careers_pages",
      "recent_news",
      "social_media",
      "team_pages",
      "broker_listings",
      "practice_details",
      "listing_pages"
    ],
    "scoring_rules": {
      "high_intent_weight": 0.8,
      "medium_intent_weight": 0.4,
      "low_intent_weight": -0.3,
      "base_score": 0.5
    }
  }
}
