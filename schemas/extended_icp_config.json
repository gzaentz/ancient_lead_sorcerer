{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lead-sorcerer.com/schemas/extended_icp_config.json",
  "title": "Extended ICP Configuration Schema with Apollo Support",
  "description": "Extended ICP configuration schema supporting traditional and Apollo lead generation modes",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 2048,
      "description": "Human-readable name for this ICP configuration"
    },
    "icp_text": {
      "type": "string",
      "maxLength": 4096,
      "description": "Detailed description of the Ideal Customer Profile"
    },
    "lead_generation_mode": {
      "type": "string",
      "enum": ["search", "url", "apollo", "database", "traditional", "specific_urls"],
      "default": "search",
      "description": "Lead generation strategy: 'search' = Domain→Crawl→Enrich, 'url' = Specific URLs, 'apollo' = Apollo-first, 'database' = Directory extraction. Legacy modes: 'traditional' (use 'search'), 'specific_urls' (use 'url')"
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      },
      "maxItems": 50,
      "description": "Search queries for traditional mode domain discovery"
    },
    "required_fields": {
      "type": "object",
      "properties": {
        "company": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 20
        },
        "contact": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 20
        }
      },
      "additionalProperties": false
    },
    "optional_fields": {
      "type": "object",
      "properties": {
        "company": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 20
        },
        "contact": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 20
        }
      },
      "additionalProperties": false
    },
    "threshold": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.7,
      "description": "ICP fit threshold for progression"
    },
    "hunter_io": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to enable Hunter.io email verification"
        },
        "min_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 70,
          "description": "Minimum Hunter.io score required for email verification (0-100%)"
        },
        "max_verifications_per_contact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Maximum number of email verification attempts per contact"
        },
        "fallback_discovery": {
          "type": "boolean",
          "default": true,
          "description": "Whether to attempt email discovery when verification fails"
        },
        "cost_tracking": {
          "type": "boolean",
          "default": true,
          "description": "Whether to track Hunter.io costs in the lead record"
        },
        "performance_optimization": {
          "type": "object",
          "properties": {
            "caching": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to enable email verification result caching"
                },
                "ttl_hours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168,
                  "default": 24,
                  "description": "Cache TTL in hours (1-168)"
                },
                "max_size": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 100000,
                  "default": 10000,
                  "description": "Maximum cache size in entries"
                }
              },
              "additionalProperties": false,
              "description": "Caching configuration for Hunter.io verification results"
            },
            "batch_verification": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to enable batch email verification"
                },
                "max_concurrent": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10,
                  "default": 5,
                  "description": "Maximum concurrent verification requests"
                },
                "batch_threshold": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 100,
                  "default": 2,
                  "description": "Minimum contacts to trigger batch verification"
                }
              },
              "additionalProperties": false,
              "description": "Batch verification configuration"
            },
            "error_handling": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to enable enhanced error handling and retry logic"
                },
                "max_retries": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10,
                  "default": 3,
                  "description": "Maximum number of retry attempts for failed requests"
                },
                "base_delay": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 10.0,
                  "default": 1.0,
                  "description": "Base delay in seconds for exponential backoff"
                },
                "max_delay": {
                  "type": "number",
                  "minimum": 10.0,
                  "maximum": 300.0,
                  "default": 60.0,
                  "description": "Maximum delay in seconds for exponential backoff"
                },
                "retry_on_rate_limit": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to retry requests that hit rate limits"
                },
                "retry_on_server_errors": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to retry requests that fail with server errors (5xx)"
                },
                "retry_on_timeouts": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to retry requests that timeout"
                }
              },
              "additionalProperties": false,
              "description": "Error handling and retry configuration for Hunter.io integration"
            }
          },
          "additionalProperties": false,
          "description": "Performance optimization and error handling settings for Hunter.io integration"
        }
      },
      "additionalProperties": false,
      "description": "Hunter.io email verification configuration"
    },
    "filtering_strict": {
      "type": "boolean",
      "default": true,
      "description": "Whether to apply strict filtering"
    },
    "mode": {
      "type": "string",
      "enum": ["fast", "thorough"],
      "default": "fast",
      "description": "Processing mode for traditional pipeline"
    },
    "refresh_policy": {
      "type": "object",
      "properties": {
        "revisit_after_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "failure_revisit_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "domain_serp_ttl_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "crawl_ttl_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      },
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "max_concurrent_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "testing": {
      "type": "object",
      "properties": {
        "process_rejected": {
          "type": "boolean"
        },
        "process_low_crawl": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "caps": {
      "type": "object",
      "properties": {
        "company_usd": {
          "type": "number",
          "minimum": 0.0,
          "description": "Maximum cost per company in USD"
        },
        "contact_usd": {
          "type": "number",
          "minimum": 0.0,
          "description": "Maximum cost per contact in USD"
        },
        "run_usd_max": {
          "type": "number",
          "minimum": 0.0,
          "description": "Maximum total cost per run in USD"
        },
        "hunter_io_usd": {
          "type": "number",
          "minimum": 0.0,
          "default": 0.002,
          "description": "Cost per Hunter.io email verification in USD"
        },
        "hunter_io_max_per_run": {
          "type": "number",
          "minimum": 0.0,
          "description": "Maximum Hunter.io verification cost per run in USD"
        }
      },
      "additionalProperties": false,
      "description": "Cost caps and limits for various services"
    },
    "role_priority": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 99
      },
      "description": "Role priority mapping (lower = higher priority)"
    },
    "exports": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "default_country": {
      "type": "string",
      "maxLength": 10,
      "description": "Default country for location-based searches"
    },
    "exclusion_criteria": {
      "type": "object",
      "properties": {
        "ownership_types": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "max_locations": {
          "type": "integer",
          "minimum": 1
        },
        "excluded_keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        }
      },
      "additionalProperties": false
    },
    "targeting": {
      "type": "object",
      "properties": {
        "location_types": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "practice_sizes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "ownership_models": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        }
      },
      "additionalProperties": false
    },
    "enrichment_providers": {
      "type": "object",
      "description": "Configuration for enrichment providers used across all lead generation modes",
      "properties": {
        "apollo": {
          "type": "object",
          "description": "Apollo enrichment provider configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether Apollo enrichment provider is enabled"
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Batch size for Apollo enrichment operations"
            }
          },
          "additionalProperties": false
        },
        "anymail_finder": {
          "type": "object",
          "description": "AnyMail Finder enrichment provider configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether AnyMail Finder enrichment provider is enabled"
            }
          },
          "additionalProperties": false
        },
        "company_enrich": {
          "type": "object",
          "description": "Company enrichment provider configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether Company enrichment provider is enabled"
            }
          },
          "additionalProperties": false
        },
        "coresignal": {
          "type": "object",
          "description": "Coresignal enrichment provider configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether Coresignal enrichment provider is enabled"
            }
          },
          "additionalProperties": false
        },
        "snovio": {
          "type": "object",
          "description": "Snov.io enrichment provider configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether Snov.io enrichment provider is enabled"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "description": "Database mode configuration for directory/listing extraction",
      "properties": {
        "sites": {
          "type": "array",
          "description": "List of database/directory sites to extract from",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256,
                "description": "Human-readable name for this site"
              },
              "base_domain": {
                "type": "string",
                "maxLength": 256,
                "description": "Base domain of the database site"
              },
              "specific_urls": {
                "type": "array",
                "description": "Specific URLs to crawl for company listings",
                "items": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 2048
                },
                "minItems": 1,
                "maxItems": 1000
              },
              "discovery_mode": {
                "type": "string",
                "enum": ["url_list", "domain_crawl"],
                "default": "url_list",
                "description": "How to discover companies: from specific URLs or crawl entire domain"
              }
            },
            "required": ["name", "base_domain", "specific_urls"],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        },
        "extraction": {
          "type": "object",
          "description": "Database extraction configuration",
          "properties": {
            "max_listings_per_site": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 100,
              "description": "Maximum number of company listings to extract per site"
            },
            "parallel_extractions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 3,
              "description": "Number of parallel extraction operations"
            },
            "use_pagination": {
              "type": "boolean",
              "default": true,
              "description": "Whether to follow pagination links"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["sites"],
      "additionalProperties": false
    },
    "apollo": {
      "type": "object",
      "description": "Apollo-specific configuration (required when lead_generation_mode == 'apollo')",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether Apollo integration is enabled"
        },
        "search": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["company_first", "person_first"],
              "default": "company_first",
              "description": "Search strategy: find companies first then contacts, or vice versa"
            },
            "company_filters": {
              "type": "object",
              "properties": {
                "industry": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "description": "Industry keywords for company filtering (loaded from icp_config)"
                },
                "size": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "description": "Company size criteria (loaded from icp_config)"
                },
                "location": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "description": "Location criteria (loaded from icp_config)"
                },
                "technologies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "description": "Technology stack criteria (loaded from icp_config)"
                },
                "funding_stage": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "description": "Funding stage criteria (loaded from icp_config)"
                }
              },
              "additionalProperties": false
            },
            "person_filters": {
              "type": "object",
              "properties": {
                "job_titles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "description": "Job title criteria (loaded from icp_config.role_priority keys)"
                },
                "seniority": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "description": "Seniority criteria (loaded from icp_config)"
                },
                "departments": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "description": "Department criteria (loaded from icp_config)"
                }
              },
              "additionalProperties": false
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1000,
              "description": "Maximum number of results to return from Apollo search"
            },
            "use_pagination": {
              "type": "boolean",
              "default": true,
              "description": "Whether to use pagination for large result sets"
            }
          },
          "additionalProperties": false
        },
        "enrich": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether to enable Apollo enrichment"
            },
            "use_bulk": {
              "type": "boolean",
              "default": true,
              "description": "Whether to use bulk enrichment operations"
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Batch size for bulk enrichment operations"
            },
            "required_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["email", "phone", "linkedin_url", "company_name", "industry", "size"]
              },
              "description": "Fields that must be present after enrichment"
            }
          },
          "additionalProperties": false
        },
        "fallback": {
          "type": "object",
          "properties": {
            "to_traditional_flow": {
              "type": "boolean",
              "default": false,
              "description": "Whether to fallback to traditional pipeline on Apollo failure"
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 3,
              "description": "Maximum number of retry attempts for Apollo operations"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lead_generation_mode": {
            "const": "apollo"
          }
        }
      },
      "then": {
        "required": ["apollo"],
        "properties": {
          "apollo": {
            "required": ["enabled"],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lead_generation_mode": {
            "const": "database"
          }
        }
      },
      "then": {
        "required": ["database"],
        "properties": {
          "database": {
            "required": ["sites"]
          }
        }
      }
    }
  ]
}
