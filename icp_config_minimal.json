{
  "name": "Dentist Practices Test - Minimal",
  "icp_text": "Independent and regional dental practice groups in the United States with 5+ locations that have 1.5M+ EBITDA and want to sell their practice, they should not be private equity backed and not part of large national franchises",
  "queries": [
    "dental practice multiple locations California"
  ],
  "required_fields": {
    "company": ["name", "hq_location", "number_of_locations"],
    "contact": ["email", "role"]
  },
  "optional_fields": {
    "company": ["tech_stack", "revenue_range", "employee_count", "specialties", "founded_year", "ownership_type"],
    "contact": ["phone", "linkedin", "decision_maker"]
  },
  "threshold": 0.3,
  "filtering_strict": true,
  "mode": "fast",
  "refresh_policy": {
    "revisit_after_days": 90,
    "failure_revisit_days": 1,
    "domain_serp_ttl_hours": 168,
    "crawl_ttl_days": 14
  },
  "concurrency": {
    "max_concurrent_requests": 1
  },
  "search": {
    "max_pages": 1
  },
  "testing": {
    "process_rejected": false,
    "process_low_crawl": false
  },
  "caps": {
    "company_usd": 0.02,
    "contact_usd": 0.03,
    "run_usd_max": 5.0
  },
  "role_priority": {
    "owner": 1,
    "CEO": 2,
    "Founder": 3,
    "office manager": 4,
    "director": 5,
    "default": 99
  },
  "exports": {
    "enabled": true
  },
  "default_country": "US",
  "intent_config": {
    "purpose": "dental_practice_acquisition",
    "target_action": "sell_practice",
    "intent_signals": {
      "high_intent": [
        "owner retirement planning",
        "succession planning",
        "looking for partners",
        "transition mode",
        "no clear family successor",
        "owner age 60+"
      ],
      "medium_intent": [
        "expansion planning",
        "growth capital needed",
        "partnership exploring",
        "early succession planning",
        "considering strategic options"
      ],
      "low_intent": [
        "recently acquired",
        "part of corporate group",
        "family succession secure",
        "no exit plans",
        "committed to independence",
        "recently expanded"
      ]
    },
    "intent_sources": [
      "about_pages",
      "leadership_pages",
      "careers_pages",
      "recent_news",
      "social_media",
      "team_pages"
    ],
    "scoring_rules": {
      "high_intent_weight": 0.8,
      "medium_intent_weight": 0.4,
      "low_intent_weight": -0.3,
      "base_score": 0.5
    }
  }
}
