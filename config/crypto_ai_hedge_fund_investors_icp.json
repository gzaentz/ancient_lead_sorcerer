{
  "name": "Crypto AI Hedge Fund Investors ICP",
  "icp_text": "Institutional investors, fund of funds, family offices, and investment firms with demonstrated interest and past investments in cryptocurrency, blockchain, artificial intelligence, and hedge fund strategies. Focus on entities that have previously invested in crypto funds, AI companies, or alternative investment vehicles.",
  
  "lead_generation_mode": "search",
  
  "queries": [
    "fund of funds crypto investments",
    "family office blockchain investments",
    "institutional investors AI hedge funds",
    "venture capital crypto funds",
    "investment firms alternative assets",
    "wealth management crypto strategies",
    "endowment crypto investments",
    "pension fund alternative investments"
  ],
  
  "required_fields": {
    "company": ["name", "domain", "industry", "size", "location", "description"],
    "contact": ["first_name", "last_name", "title", "email", "linkedin_url"]
  },
  
  "optional_fields": {
    "company": ["website", "technologies", "funding_stage", "employee_count", "revenue_range"],
    "contact": ["phone", "department", "seniority", "company_name"]
  },
  
  "threshold": 0.8,
  "filtering_strict": true,
  "mode": "thorough",
  
  "apollo": {
    "enabled": true,
    "fallback_to_traditional": true,
    
    "search": {
      "strategy": "company_first",
      "max_results": 200,
      
      "company_filters": {
        "industry": [
          "Investment Management",
          "Venture Capital",
          "Private Equity",
          "Financial Services",
          "Asset Management",
          "Wealth Management",
          "Investment Banking",
          "Hedge Fund",
          "Family Office",
          "Fund of Funds",
          "Alternative Investments",
          "Cryptocurrency",
          "Blockchain",
          "Artificial Intelligence",
          "Fintech",
          "Investment Advisory"
        ],
        "size": [
          "11-50",
          "51-200",
          "201-500",
          "501-1000",
          "1001-5000",
          "5001-10000",
          "10001+"
        ],
        "location": [
          "United States",
          "United Kingdom",
          "Switzerland",
          "Singapore",
          "Hong Kong",
          "Canada",
          "Germany",
          "Netherlands",
          "Luxembourg",
          "Cayman Islands",
          "Bermuda",
          "United Arab Emirates"
        ],
        "technologies": [
          "Blockchain",
          "Cryptocurrency",
          "Artificial Intelligence",
          "Machine Learning",
          "Data Analytics",
          "Cloud Computing",
          "API Integration",
          "Mobile Applications"
        ],
        "funding_stage": [
          "Series A",
          "Series B",
          "Series C",
          "Series D",
          "Private Equity",
          "Established",
          "IPO"
        ]
      },
      
      "person_filters": {
        "job_titles": [
          "Managing Partner",
          "Partner",
          "Managing Director",
          "Director",
          "Principal",
          "Investment Director",
          "Investment Manager",
          "Portfolio Manager",
          "Chief Investment Officer",
          "Chief Executive Officer",
          "President",
          "Vice President",
          "Senior Vice President",
          "Head of Investments",
          "Head of Alternative Investments",
          "Head of Private Markets",
          "Investment Committee Member"
        ],
        "seniority": [
          "C-Level",
          "Partner",
          "Managing Director",
          "Director",
          "Principal",
          "VP",
          "Head"
        ],
        "departments": [
          "Investment",
          "Private Equity",
          "Venture Capital",
          "Alternative Investments",
          "Portfolio Management",
          "Asset Management",
          "Investment Committee",
          "Executive",
          "Business Development"
        ]
      }
    },
    
    "enrich": {
      "enabled": true,
      "quality_thresholds": {
        "min_employee_count": 10,
        "min_contact_quality": 0.85,
        "required_contact_fields": ["email", "title", "linkedin_url"],
        "required_company_fields": ["description", "industry"]
      }
    }
  },
  
  "refresh_policy": {
    "revisit_after_days": 60,
    "failure_revisit_days": 7,
    "domain_serp_ttl_hours": 48,
    "crawl_ttl_days": 30
  },
  
  "concurrency": {
    "max_concurrent_requests": 3
  },
  
  "search": {
    "max_pages": 8
  },
  
  "testing": {
    "process_rejected": false,
    "process_low_crawl": false
  },
  
  "caps": {
    "company_usd": 0.05,
    "contact_usd": 0.08,
    "run_usd_max": 25.0,
    "apollo_credits_max": 2000
  },
  
  "role_priority": {
    "Managing Partner": 1,
    "Partner": 2,
    "Managing Director": 3,
    "Chief Investment Officer": 4,
    "Investment Director": 5,
    "Principal": 6,
    "Director": 7,
    "Head of Investments": 8,
    "Head of Alternative Investments": 9,
    "Portfolio Manager": 10,
    "Investment Manager": 11,
    "Vice President": 12,
    "Senior Vice President": 13,
    "default": 99
  },
  
  "exports": {
    "enabled": true,
    "formats": ["csv", "json", "xlsx"],
    "include_apollo_data": true
  },
  
  "default_country": "US",
  
  "exclusion_criteria": {
    "ownership_types": [
      "Sole Proprietorship",
      "Partnership (non-investment)",
      "Non-profit"
    ],
    "max_locations": 50,
    "excluded_keywords": [
      "consulting",
      "agency",
      "freelance",
      "individual",
      "personal",
      "retail",
      "consumer",
      "startup accelerator",
      "incubator"
    ]
  },
  
  "targeting": {
    "location_types": [
      "Financial Districts",
      "Major Metropolitan Areas",
      "Financial Centers",
      "Offshore Financial Centers"
    ],
    "practice_sizes": [
      "Mid-size Investment Firms",
      "Large Asset Managers",
      "Established Family Offices",
      "Institutional Investment Firms"
    ],
    "ownership_models": [
      "Partnership",
      "Private Company",
      "Public Company",
      "Family-owned",
      "Institutionally-owned"
    ]
  },
  
  "enrichment_providers": {
    "apollo": {
      "enabled": true,
      "priority": 1,
      "batch_size": 25
    },
    "anymail_finder": {
      "enabled": true,
      "priority": 2
    },
    "company_enrich": {
      "enabled": true,
      "priority": 3
    },
    "coresignal": {
      "enabled": true,
      "priority": 4
    },
    "snovio": {
      "enabled": true,
      "priority": 5
    }
  },
  
  "apollo_advanced": {
    "rate_limiting": {
      "requests_per_minute": 40,
      "requests_per_hour": 800,
      "burst_limit": 8
    },
    
    "search_optimization": {
      "use_boolean_queries": true,
      "exclude_keywords": [
        "consulting",
        "agency",
        "freelance",
        "individual",
        "personal",
        "retail",
        "consumer"
      ],
      "include_keywords": [
        "investment",
        "fund",
        "capital",
        "venture",
        "private equity",
        "asset management",
        "wealth management",
        "family office",
        "fund of funds",
        "institutional",
        "alternative investments"
      ],
      "location_radius_miles": 100
    },
    
    "quality_scoring": {
      "company_score_weights": {
        "industry_match": 0.35,
        "size_match": 0.15,
        "location_match": 0.20,
        "description_match": 0.30
      },
      "contact_score_weights": {
        "title_match": 0.45,
        "seniority_match": 0.30,
        "department_match": 0.15,
        "location_match": 0.10
      }
    },
    
    "fallback_strategy": {
      "enable_traditional_fallback": true,
      "apollo_failure_threshold": 5,
      "traditional_fallback_delay_minutes": 10
    }
  },
  
  "hunter_io": {
    "enabled": true,
    "min_score": 80,
    "max_verifications_per_contact": 2,
    "fallback_discovery": true,
    "cost_tracking": true,
    "performance_optimization": {
      "caching": {
        "enabled": true,
        "ttl_hours": 48,
        "max_size": 5000
      },
      "batch_verification": {
        "enabled": true,
        "max_concurrent": 3,
        "batch_threshold": 5
      },
      "error_handling": {
        "enabled": true,
        "max_retries": 3,
        "base_delay": 2.0,
        "max_delay": 120.0,
        "retry_on_rate_limit": true,
        "retry_on_server_errors": true,
        "retry_on_timeouts": true
      }
    }
  }
}
