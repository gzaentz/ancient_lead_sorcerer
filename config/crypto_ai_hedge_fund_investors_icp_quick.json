{
  "name": "Crypto AI Hedge Fund Investors ICP",
  "icp_text": "Institutional investors, fund of funds, family offices, and investment firms with demonstrated interest and past investments in cryptocurrency, blockchain, artificial intelligence, and hedge fund strategies. Focus on entities that have previously invested in crypto funds, AI companies, or alternative investment vehicles.",

  "lead_generation_mode": "search",

  "queries": [
    "family office crypto AI investments"
  ],
  "specific_urls": ["https://www.nikolajsencapital.ch"],
  "required_fields": {
    "company": ["name", "domain", "industry", "size", "location", "description"],
    "contact": ["first_name", "last_name", "title", "email", "linkedin_url"]
  },

  "optional_fields": {
    "company": ["website", "technologies", "funding_stage", "employee_count", "revenue_range"],
    "contact": ["phone", "department", "seniority", "company_name"]
